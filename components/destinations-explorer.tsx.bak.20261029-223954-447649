"use client"

import { useCallback, useEffect, useMemo, useState } from "react"
import Link from "next/link"
import { AlertCircle, ArrowUpRight, Check, ChevronRight, Compass, MapPinned, Mountain, RefreshCw, Search, SlidersHorizontal } from "lucide-react"
import HikingMap from "@/components/hiking-map"
import {
  type HikingMountain,
  formatElevation,
  requestHikingCatalog,
} from "@/lib/hiking"

type DestinationsExplorerProps = {
  initialMountains: HikingMountain[]
  initialError?: string | null
}

function getMountainLocation(mountain: HikingMountain) {
  return [mountain.regency, mountain.province].filter(Boolean).join(", ") || "Wilayah belum diisi"
}

export default function DestinationsExplorer({ initialMountains, initialError = null }: DestinationsExplorerProps) {
  const [mountains, setMountains] = useState(initialMountains)
  const [activeSlug, setActiveSlug] = useState<string | null>(initialMountains[0]?.slug ?? null)
  const [query, setQuery] = useState("")
  const [province, setProvince] = useState("")
  const [viewMode, setViewMode] = useState<"map" | "list">("list")
  const [loading, setLoading] = useState(false)
  const [error, setError] = useState(initialError)
  const [retryKey, setRetryKey] = useState(0)

  const provinces = useMemo(() => {
    return Array.from(new Set(initialMountains.map((mountain) => mountain.province).filter((value): value is string => Boolean(value))))
      .sort((left, right) => left.localeCompare(right, "id"))
  }, [initialMountains])

  const loadMountains = useCallback(async (search: string, selectedProvince: string, signal: AbortSignal) => {
    if (!search.trim() && !selectedProvince) {
      setMountains(initialMountains)
      setActiveSlug((current) => initialMountains.some((mountain) => mountain.slug === current) ? current : (initialMountains[0]?.slug ?? null))
      setError(initialError)
      setLoading(false)
      return
    }
    setLoading(true)
    setError(null)
    try {
      const response = await requestHikingCatalog<HikingMountain>({
        resource: "mountains",
        q: search.trim() || undefined,
        province: selectedProvince || undefined,
        limit: 50,
        offset: 0,
      }, signal)
      const items = response.items ?? []
      setMountains(items)
      setActiveSlug((current) => items.some((mountain) => mountain.slug === current) ? current : (items[0]?.slug ?? null))
      setError(null)
    } catch (cause) {
      if (signal.aborted) return
      setError(cause instanceof Error ? cause.message : "Destinasi tidak dapat dimuat.")
      setMountains([])
      setActiveSlug(null)
    } finally {
      if (!signal.aborted) setLoading(false)
    }
  }, [initialMountains, initialError])

  useEffect(() => {
    const controller = new AbortController()
    const timeout = window.setTimeout(() => {
      void loadMountains(query, province, controller.signal)
    }, query.trim() || province ? 300 : 0)
    return () => {
      window.clearTimeout(timeout)
      controller.abort()
    }
  }, [query, province, retryKey, loadMountains])

  const activeMountain = mountains.find((mountain) => mountain.slug === activeSlug) ?? null

  return (
    <section className="px-4 pb-20 sm:px-6 sm:pb-24 lg:px-8">
      <div className="mx-auto max-w-7xl">
        <div className="relative z-10 -mt-7 rounded-[1.5rem] border border-border/70 bg-card/95 p-3 shadow-xl shadow-slate-950/5 backdrop-blur-xl sm:p-4">
          <div className="flex flex-col gap-3 md:flex-row md:items-center">
            <label className="flex min-h-11 flex-1 items-center gap-3 rounded-xl border border-border/70 bg-background px-3.5 focus-within:border-primary/50 focus-within:ring-2 focus-within:ring-primary/10">
              <Search className="size-4 shrink-0 text-muted-foreground" aria-hidden="true" />
              <span className="sr-only">Cari gunung atau destinasi</span>
              <input
                value={query}
                onChange={(event) => setQuery(event.target.value)}
                placeholder="Cari gunung atau destinasi…"
                className="min-w-0 flex-1 bg-transparent text-sm outline-none placeholder:text-muted-foreground/75"
                type="search"
                autoComplete="off"
              />
              {query && <button type="button" onClick={() => setQuery("")} className="rounded-full px-2 py-1 text-xs font-semibold text-muted-foreground hover:bg-muted hover:text-foreground">Hapus</button>}
            </label>
            <label className="flex min-h-11 items-center gap-2 rounded-xl border border-border/70 bg-background px-3.5 md:w-[230px]">
              <SlidersHorizontal className="size-4 shrink-0 text-muted-foreground" aria-hidden="true" />
              <span className="sr-only">Filter provinsi</span>
              <select value={province} onChange={(event) => setProvince(event.target.value)} className="min-w-0 flex-1 bg-transparent text-sm outline-none">
                <option value="">Semua wilayah</option>
                {provinces.map((name) => <option key={name} value={name}>{name}</option>)}
              </select>
            </label>
            <div className="grid grid-cols-2 gap-1 rounded-xl border border-border/70 bg-muted/60 p-1 md:hidden" role="group" aria-label="Tampilan destinasi">
              <button type="button" aria-pressed={viewMode === "list"} onClick={() => setViewMode("list")} className={"inline-flex h-9 items-center justify-center gap-2 rounded-lg text-xs font-semibold transition " + (viewMode === "list" ? "bg-card text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")}><Mountain className="size-3.5" /> Daftar</button>
              <button type="button" aria-pressed={viewMode === "map"} onClick={() => setViewMode("map")} className={"inline-flex h-9 items-center justify-center gap-2 rounded-lg text-xs font-semibold transition " + (viewMode === "map" ? "bg-card text-foreground shadow-sm" : "text-muted-foreground hover:text-foreground")}><MapPinned className="size-3.5" /> Peta</button>
            </div>
          </div>
        </div>

        <div className="mb-4 mt-7 flex flex-wrap items-end justify-between gap-3">
          <div>
            <span className="section-eyebrow"><Compass className="size-3.5" /> Peta & katalog</span>
            <h2 className="mt-2 text-xl font-semibold tracking-tight sm:text-2xl">Destinasi pendakian</h2>
            <p className="mt-1 text-xs leading-5 text-muted-foreground">Hanya destinasi yang dipublikasikan oleh sistem yang akan ditampilkan.</p>
          </div>
          <div className="inline-flex items-center gap-2 rounded-full border border-border/70 bg-card px-3 py-2 text-xs font-medium text-muted-foreground" aria-live="polite">
            {loading ? <span className="size-2 animate-pulse rounded-full bg-primary" /> : <span className="size-2 rounded-full bg-emerald-500" />}
            {loading ? "Memperbarui data…" : mountains.length + (mountains.length === 1 ? " destinasi" : " destinasi")}
          </div>
        </div>

        {error && (
          <div className="mb-4 flex flex-col gap-3 rounded-2xl border border-amber-500/25 bg-amber-500/[0.06] p-4 sm:flex-row sm:items-center sm:justify-between">
            <div className="flex items-start gap-2.5"><AlertCircle className="mt-0.5 size-4 shrink-0 text-amber-600 dark:text-amber-300" /><div><p className="text-sm font-semibold">Informasi destinasi belum dapat dimuat</p><p className="mt-1 break-words text-xs leading-5 text-muted-foreground">{error}</p></div></div>
            <button type="button" onClick={() => setRetryKey((value) => value + 1)} className="inline-flex h-9 shrink-0 items-center justify-center gap-2 rounded-full border border-border bg-card px-3.5 text-xs font-semibold transition hover:bg-muted"><RefreshCw className="size-3.5" /> Coba lagi</button>
          </div>
        )}

        <div className="grid items-start gap-4 lg:grid-cols-[minmax(310px,0.77fr)_minmax(0,1.43fr)]">
          <div className={viewMode === "list" ? "block lg:block" : "hidden lg:block"}>
            <div className="hiking-destination-list space-y-2.5 lg:max-h-[min(72vh,760px)] lg:overflow-y-auto lg:pr-1">
              {loading && mountains.length === 0 && !error && (
                <div className="space-y-2.5" role="status" aria-live="polite">
                  {[0, 1, 2].map((item) => <div key={item} className="h-28 animate-pulse rounded-2xl border border-border/60 bg-card" />)}
                  <span className="sr-only">Memuat daftar destinasi</span>
                </div>
              )}
              {!loading && !error && mountains.length === 0 && (
                <div className="rounded-2xl border border-dashed border-border bg-card px-5 py-9 text-center">
                  <span className="mx-auto flex size-12 items-center justify-center rounded-2xl bg-primary/10 text-primary"><Mountain className="size-5" /></span>
                  <h3 className="mt-4 text-base font-semibold">Belum ada destinasi dipublikasikan</h3>
                  <p className="mt-2 text-sm leading-6 text-muted-foreground">Destinasi akan muncul di sini setelah data diverifikasi dan dipublikasikan. Coba kembali nanti.</p>
                  {(query || province) && <button type="button" onClick={() => { setQuery(""); setProvince("") }} className="mt-4 text-xs font-semibold text-primary underline underline-offset-4">Hapus pencarian</button>}
                </div>
              )}
              {mountains.map((mountain) => {
                const selected = mountain.slug === activeSlug
                const elevation = formatElevation(mountain.elevation_m)
                return (
                  <article key={mountain.mountain_id} className={"overflow-hidden rounded-2xl border transition " + (selected ? "border-primary/40 bg-card shadow-md shadow-primary/5" : "border-border/60 bg-card hover:border-primary/25")}>
                    <button type="button" aria-pressed={selected} onClick={() => setActiveSlug(mountain.slug)} className="flex w-full items-start gap-3 p-4 text-left">
                      <span className={"flex size-10 shrink-0 items-center justify-center rounded-xl transition-colors " + (selected ? "bg-primary text-primary-foreground" : "bg-secondary text-secondary-foreground")}><Mountain className="size-5" /></span>
                      <span className="min-w-0 flex-1">
                        <span className="block text-sm font-semibold leading-5">{mountain.name}</span>
                        <span className="mt-1 block text-xs leading-5 text-muted-foreground">{getMountainLocation(mountain)}</span>
                        {elevation && <span className="mt-2 inline-flex items-center rounded-full bg-muted px-2.5 py-1 text-[10px] font-semibold text-muted-foreground">{elevation}</span>}
                        {mountain.verified_at && <span className="mt-2 flex items-center gap-1 text-[10px] font-medium text-emerald-700 dark:text-emerald-300"><Check className="size-3" /> Data memiliki waktu verifikasi</span>}
                      </span>
                      <ChevronRight className={"mt-1 size-4 shrink-0 transition-transform " + (selected ? "translate-x-0.5 text-primary" : "text-muted-foreground")} />
                    </button>
                    <div className="flex items-center justify-between gap-3 border-t border-border/60 px-4 py-3">
                      <span className="truncate text-[10px] text-muted-foreground">{mountain.is_volcanic === true ? "Gunung vulkanik" : "Destinasi alam"}</span>
                      <Link href={"/destinasi/" + mountain.slug} className="inline-flex shrink-0 items-center gap-1 text-xs font-semibold text-primary hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring">Lihat detail <ArrowUpRight className="size-3.5" /></Link>
                    </div>
                  </article>
                )
              })}
            </div>
          </div>

          <div className={viewMode === "map" ? "block lg:block" : "hidden lg:block"}>
            <div className="sticky top-24">
              <HikingMap
                mountains={mountains}
                activeMountainSlug={activeSlug}
                onSelectMountain={setActiveSlug}
                className="h-[58svh] min-h-[390px] max-h-[760px] lg:h-[min(72vh,760px)]"
              />
              {activeMountain && (
                <div className="mt-3 flex flex-col gap-3 rounded-2xl border border-border/60 bg-card p-4 sm:flex-row sm:items-center sm:justify-between">
                  <div className="min-w-0"><p className="text-sm font-semibold">{activeMountain.name}</p><p className="mt-1 truncate text-xs text-muted-foreground">{getMountainLocation(activeMountain)}</p></div>
                  <Link href={"/destinasi/" + activeMountain.slug} className="inline-flex h-9 shrink-0 items-center justify-center gap-2 rounded-full bg-primary px-4 text-xs font-semibold text-primary-foreground transition hover:opacity-90">Detail destinasi <ArrowUpRight className="size-3.5" /></Link>
                </div>
              )}
              {mountains.length === 0 && (
                <div className="mt-3 flex items-start gap-2 rounded-xl border border-border/60 bg-card/80 px-3.5 py-3">
                  <MapPinned className="mt-0.5 size-4 shrink-0 text-primary" /><p className="text-xs leading-5 text-muted-foreground">Peta dasar dapat dijelajahi, tetapi marker destinasi baru muncul setelah data lokasi dipublikasikan.</p>
                </div>
              )}
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}
