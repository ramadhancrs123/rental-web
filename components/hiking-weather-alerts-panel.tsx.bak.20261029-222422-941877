"use client"

import { useEffect, useState } from "react"
import { AlertTriangle, ExternalLink, RefreshCw, ShieldAlert } from "lucide-react"
import { type HikingWeatherAlert, requestHikingCatalog, formatIndonesianDate } from "@/lib/hiking"

type Props = { province?: string | null; regency?: string | null }

function severityLabel(value?: string | null) {
  if (!value) return "Tingkat keparahan belum dijelaskan"
  const normalized = value.toLowerCase()
  if (normalized === "extreme") return "Ekstrem"
  if (normalized === "severe") return "Berat"
  if (normalized === "moderate") return "Sedang"
  if (normalized === "minor") return "Rendah"
  return value
}

function areaLabel(alert: HikingWeatherAlert) {
  const areas = alert.affected_areas ?? []
  if (!areas.length) return "Cakupan area tidak tersedia di respons ini"
  return areas.slice(0, 3).map((area) => {
    const values = [area.areaDesc, area.description, area.regency, area.district, area.province]
      .filter((value): value is string => typeof value === "string" && Boolean(value.trim()))
    return values[0] ?? null
  }).filter(Boolean).join(" · ") || "Periksa cakupan area pada sumber resmi"
}

export default function HikingWeatherAlertsPanel({ province, regency }: Props) {
  const [items, setItems] = useState<HikingWeatherAlert[]>([])
  const [checkedAt, setCheckedAt] = useState<string | null>(null)
  const [error, setError] = useState(false)
  const [completedKey, setCompletedKey] = useState<string | null>(null)
  const [retry, setRetry] = useState(0)
  const requestKey = (province ?? "") + ":" + retry
  const loading = completedKey !== requestKey

  useEffect(() => {
    const controller = new AbortController()
    requestHikingCatalog<HikingWeatherAlert>({
      resource: "alerts",
      province: province || undefined,
      limit: 10,
    }, controller.signal)
      .then((response) => {
        if (controller.signal.aborted) return
        setItems(response.items ?? [])
        setCheckedAt(typeof response.checkedAt === "string" ? response.checkedAt : null)
        setError(false)
      })
      .catch(() => {
        if (!controller.signal.aborted) {
          setItems([])
          setCheckedAt(null)
          setError(true)
        }
      })
      .finally(() => { if (!controller.signal.aborted) setCompletedKey(requestKey) })
    return () => controller.abort()
  }, [province, retry, requestKey])

  const visibleItems = loading ? [] : items
  const visibleError = !loading && error
  const visibleCheckedAt = loading ? null : checkedAt
  const filteredItems = regency
    ? visibleItems.filter((alert) => {
        const searchText = JSON.stringify(alert.affected_areas ?? []).toLocaleLowerCase("id")
        return searchText.includes(regency.toLocaleLowerCase("id"))
      })
    : visibleItems

  return (
    <section className="overflow-hidden rounded-3xl border border-border/60 bg-card">
      <div className="flex items-start gap-3 border-b border-border/60 p-5 sm:p-6">
        <span className="flex size-10 shrink-0 items-center justify-center rounded-xl bg-amber-500/10 text-amber-700 dark:text-amber-300"><ShieldAlert className="size-5" /></span>
        <div className="min-w-0 flex-1">
          <h2 className="text-base font-semibold tracking-tight">Peringatan cuaca BMKG</h2>
          <p className="mt-1 text-xs leading-5 text-muted-foreground">{province ? "Cakupan pencarian: " + province : "Peringatan aktif yang dikembalikan oleh feed BMKG."} · Bukan penilaian status jalur.</p>
        </div>
      </div>
      <div className="p-5 sm:p-6">
        {loading && <div className="space-y-2" role="status" aria-live="polite"><div className="h-20 animate-pulse rounded-2xl bg-muted" /><div className="h-20 animate-pulse rounded-2xl bg-muted" /><span className="sr-only">Memeriksa peringatan cuaca</span></div>}
        {!loading && visibleError && (
          <div className="rounded-2xl border border-amber-500/25 bg-amber-500/[0.06] p-4">
            <div className="flex items-start gap-2.5"><AlertTriangle className="mt-0.5 size-4 shrink-0 text-amber-600 dark:text-amber-300" /><p className="text-sm leading-6 text-muted-foreground">Peringatan cuaca tidak dapat diperiksa saat ini. Periksa langsung sumber resmi BMKG.</p></div>
            <button type="button" onClick={() => setRetry((value) => value + 1)} className="mt-3 inline-flex h-9 items-center gap-2 rounded-full border border-border bg-card px-3.5 text-xs font-semibold transition hover:bg-muted"><RefreshCw className="size-3.5" /> Coba lagi</button>
          </div>
        )}
        {!loading && !error && filteredItems.length === 0 && (
          <div className="rounded-2xl border border-dashed border-border p-4">
            <p className="text-sm font-semibold">Belum ada peringatan yang cocok ditampilkan</p>
            <p className="mt-1 text-xs leading-5 text-muted-foreground">Ini bukan jaminan kondisi aman atau berarti tidak ada risiko. Periksa cakupan peringatan dan informasi terbaru langsung dari BMKG sebelum berangkat.</p>
          </div>
        )}
        {!loading && !error && filteredItems.length > 0 && (
          <div className="space-y-2.5">
            {filteredItems.map((alert) => {
              const href = alert.web_url || alert.source_url
              return (
                <article key={alert.alert_id} className="rounded-2xl border border-amber-500/20 bg-amber-500/[0.045] p-4">
                  <div className="flex flex-wrap items-center gap-2">
                    <span className="rounded-full bg-amber-500/10 px-2.5 py-1 text-[10px] font-semibold text-amber-800 dark:text-amber-200">{severityLabel(alert.severity)}</span>
                    {alert.urgency && <span className="text-[10px] text-muted-foreground">Urgensi: {alert.urgency}</span>}
                  </div>
                  <h3 className="mt-3 text-sm font-semibold leading-5">{alert.headline || alert.event || "Peringatan cuaca"}</h3>
                  {alert.description && <p className="mt-2 text-xs leading-5 text-muted-foreground">{alert.description}</p>}
                  {alert.instruction && <p className="mt-2 rounded-xl bg-background/75 p-3 text-xs leading-5"><span className="font-semibold">Arahan sumber:</span> {alert.instruction}</p>}
                  <p className="mt-3 text-[10px] leading-4 text-muted-foreground">Cakupan: {areaLabel(alert)}</p>
                  <p className="mt-1 text-[10px] text-muted-foreground">Berlaku: {formatIndonesianDate(alert.effective_at) ?? "Waktu mulai tidak tersedia"} · Berakhir: {formatIndonesianDate(alert.expires_at) ?? "Waktu akhir tidak tersedia"}</p>
                  {href?.startsWith("https://") && <a href={href} target="_blank" rel="noreferrer" className="mt-3 inline-flex items-center gap-1.5 text-xs font-semibold text-primary hover:underline">Lihat sumber <ExternalLink className="size-3.5" /></a>}
                </article>
              )
            })}
          </div>
        )}
        <div className="mt-4 border-t border-border/60 pt-3 text-[10px] leading-5 text-muted-foreground">
          <p>Sumber: <a href="https://www.bmkg.go.id/" target="_blank" rel="noreferrer" className="font-semibold underline underline-offset-2 hover:text-foreground">BMKG</a>. {checkedAt ? "Feed diperiksa " + (formatIndonesianDate(checkedAt) ?? checkedAt) + "." : "Waktu pemeriksaan feed tidak tersedia."} Peringatan regional tidak otomatis mewakili kondisi di sepanjang jalur atau puncak.</p>
        </div>
      </div>
    </section>
  )
}
